# Defina isso no painel da Vercel (Settings > Environment Variables), não aqui.
# ADMIN_PASSWORD é a senha que vocês dois vão usar para adicionar/remover fotos em /admin.html
ADMIN_PASSWORD=escolha-uma-senha-so-de-voces

# BLOB_READ_WRITE_TOKEN é criado AUTOMATICAMENTE quando você ativa o Vercel Blob
# no seu projeto (Storage > Create Database > Blob). Não precisa copiar isso manualmente.
